    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "mobx": "6.13.7",
    "mobx-react": "7.6.0",
    "react": "17.0.2",
    "react-dom": "17.0.2"
  },
  "devDependencies": {
    "@types/react": "17.0.87",
    "@types/react-dom": "17.0.26",
    "css-loader": "6.11.0",
    "less": "4.3.0",
    "less-loader": "11.1.4",
    "mini-css-extract-plugin": "2.9.2",
    "ts-loader": "9.5.2",
    "typescript": "5.8.3",
    "webpack": "5.104.1",
    "webpack-cli": "5.1.4"
  }
}
